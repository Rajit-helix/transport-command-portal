NODE_ENV=production
PORT=4000
DATABASE_URL=postgres://user:password@db:5432/transport_db
JWT_SECRET=use_docker_secret_or_vault_ref
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
CORS_ORIGINS=https://transport.example.com
REDIS_URL=redis://redis:6379
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_AUTH=5
RATE_LIMIT_MAX_BOOKING=20
LOG_LEVEL=info
